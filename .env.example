# Copy to .env. The street server reads this file on startup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition

# Fish Audio speaks the replies. https://fish.audio
FISH_AUDIO_API_KEY=
# s2.1-pro needs paid API credit. s2.1-pro-free speaks on a key with none.
FISH_AUDIO_MODEL=s2.1-pro-free
# Fallback only. Each person already has their own voice.
# FISH_VOICE_FEMALE=
# FISH_VOICE_MALE=

# local = never call OpenRouter. live = call when a key is set.
DIALOG=live
