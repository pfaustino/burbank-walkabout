# Copy to .env. The street server reads this file on startup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition

# Optional. When NVIDIA_API_KEY is set, sidewalk talk uses NVIDIA NIM instead of OpenRouter.
# Key: https://build.nvidia.com/settings
# Model ids look like meta/llama-3.3-70b-instruct
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Fish Audio speaks the replies. https://fish.audio
FISH_AUDIO_API_KEY=
# s2.1-pro needs paid API credit. s2.1-pro-free speaks on a key with none.
FISH_AUDIO_MODEL=s2.1-pro-free
# Fallback only. Each person already has their own voice.
# FISH_VOICE_FEMALE=
# FISH_VOICE_MALE=

# local = scripted replies. live = NVIDIA when NVIDIA_API_KEY is set, otherwise OpenRouter when that key is set.
DIALOG=live

# Google Maps Embed API key, locked to Maps Embed and to this site's addresses.
# Street View in the page stays blank without it. The embed itself is not charged.
VITE_GOOGLE_MAPS_EMBED_KEY=
